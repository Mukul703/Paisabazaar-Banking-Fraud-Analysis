          <calculation class='tableau' formula='IF CONTAINS([Type_of_Loan], &quot;Auto Loan&quot;) THEN &quot;Auto Loan&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type_of_Loan], &quot;Credit-Builder&quot;) THEN &quot;Credit Builder Loan&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type_of_Loan], &quot;Debt Consolidation&quot;) THEN &quot;Debt Consolidation Loan&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type_of_Loan], &quot;Home Equity&quot;) THEN &quot;Home Equity Loan&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type_of_Loan], &quot;Mortgage&quot;) THEN &quot;Mortgage Loan&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type_of_Loan], &quot;Payday&quot;) THEN &quot;Payday Loan&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type_of_Loan], &quot;Personal&quot;) THEN &quot;Personal Loan&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type_of_Loan], &quot;Student&quot;) THEN &quot;Student Loan&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
